{
  "$schema": "https://schema.tauri.app/config/2", "productName": "GBMarkdown", "version": "0.5.0",
  "identifier": "com.gbmarkdown.reader",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "GBMarkdown", "width": 1280, "height": 860, "minWidth": 700, "minHeight": 480, "dragDropEnabled": true, "decorations": false }],
    "security": { "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; frame-src 'none'" }
  },
  "bundle": {
    "active": true, "targets": ["nsis"], "shortDescription": "GB-scale offline Markdown reader", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "fileAssociations": [{"ext": ["md", "markdown", "mdown"], "name": "Markdown document", "role": "Viewer"}],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": true }, "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  }
}
